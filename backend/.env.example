# --- Database ---------------------------------------------------------------
# Neon (free tier):  postgresql+psycopg2://USER:PASS@HOST/DB?sslmode=require
# Local Postgres:    postgresql+psycopg2://postgres:password@localhost:5432/jobtrack
# Zero-install dev:  sqlite:///./jobtrack.db   (fine for trying things out)
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/jobtrack

# --- Auth -------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (JSON list) -------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173"]

# --- LLM (server-side only) -------------------------------------------------
# LLM_PROVIDER: groq | openrouter
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_TIMEOUT_SECONDS=30
# Max LLM calls per user per minute
LLM_RATE_LIMIT_PER_MINUTE=5

# --- Scheduler --------------------------------------------------------------
ENABLE_SCHEDULER=true
REMINDER_CHECK_INTERVAL_MINUTES=60
